# Application
APP_NAME=ReTrace
APP_ENV=development
DEBUG=true

# Database
# Local Docker PostgreSQL:
DATABASE_URL=postgresql+asyncpg://retrace:retrace_dev_password@localhost:5432/retrace
# Production PostgreSQL must be provided as an environment secret.

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Server
HOST=0.0.0.0
PORT=8000
WEBSOCKET_PORT=8001

# LLM Providers
OPENAI_API_KEY=sk-your-openai-api-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# Embedding Model
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# Reasoning Model
REASONING_MODEL=gpt-4o
VISION_MODEL=gpt-4-vision-preview

# Supabase (remote auth — leave empty for local-only auth)
SUPABASE_URL=
SUPABASE_JWT_SECRET=

# Gateway (vendor-agnostic LLM proxy — "direct" = no gateway)
GATEWAY_PROVIDER=direct
GATEWAY_BASE_URL=
GATEWAY_ADMIN_KEY=

# Logging
LOG_LEVEL=DEBUG
RETRACE_LLM_LOG_FALLBACK=1
LOG_FORMAT=json

# TeamKnowParse KB pipeline
TEAMKNOWPARSE_KB_ENABLED=true
TEAMKNOWPARSE_VECTOR_ENABLED=true
TEAMKNOWPARSE_PIPELINE_ENABLED=true
TEAMKNOWPARSE_PROJECT_DIR=/home/ubuntu/Desktop/retrace-enterprise-feature/teamknowparse
TEAMKNOWPARSE_UPLOADS_DIR=/home/ubuntu/Desktop/retrace-enterprise-feature/teamknowparse/uploads
TEAMKNOWPARSE_RUNS_DIR=/home/ubuntu/Desktop/retrace-enterprise-feature/teamknowparse/runs
# Optional override. Default command is: python -m teamknowparse.cli <upload_dir> --out <runs_dir> --mode <mode>
TEAMKNOWPARSE_COMMAND=
TEAMKNOWPARSE_EMBEDDING_MODEL=qwen3-embedding-4b
TEAMKNOWPARSE_EMBEDDING_BASE_URL=
# Example local OpenAI-compatible embedding server:
# TEAMKNOWPARSE_EMBEDDING_BASE_URL=http://127.0.0.1:8024/v1
TEAMKNOWPARSE_EMBEDDING_BATCH_SIZE=96
TEAMKNOWPARSE_EMBEDDING_CONCURRENCY=4
TEAMKNOWPARSE_EMBEDDING_SUBCHUNK_CHARS=1600
TEAMKNOWPARSE_EMBEDDING_SUBCHUNK_OVERLAP=160
TEAMKNOWPARSE_EMBEDDING_BATCH_MAX_CHARS=120000
TEAMKNOWPARSE_EMBEDDING_DEBUG_LOG=false
TEAMKNOWPARSE_VLM_ENDPOINT=
TEAMKNOWPARSE_VLM_MODEL=qwen3.5-2b
TEAMKNOWPARSE_VLM_WORKERS=10
TEAMKNOWPARSE_VLM_BATCH_SIZE=1
TEAMKNOWPARSE_MAX_INFLIGHT_VLM_BATCHES=8
TEAMKNOWPARSE_VLM_REQUEST_TIMEOUT_SECONDS=45
TEAMKNOWPARSE_MIXED_VLM_ENABLED=true
TEAMKNOWPARSE_MIXED_VLM_MIN_IMAGE_AREA_RATIO=0.04
TEAMKNOWPARSE_MIXED_VLM_MAX_REGIONS_PER_PAGE=2
TEAMKNOWPARSE_MIXED_VLM_HEADER_FOOTER_BAND_RATIO=0.10
TEAMKNOWPARSE_MIXED_VLM_MIN_CROP_HEIGHT_PX=96
TEAMKNOWPARSE_MIXED_VLM_MIN_CROP_WIDTH_PX=96
TEAMKNOWPARSE_VLM_TEMPERATURE=0
TEAMKNOWPARSE_VLM_TOP_P=1
TEAMKNOWPARSE_VLM_TOP_K=1
TEAMKNOWPARSE_VLM_MAX_TOKENS=1024
TEAMKNOWPARSE_VLM_COMPLEX_MAX_TOKENS=2048
TEAMKNOWPARSE_VLM_MIN_PIXELS=200704
TEAMKNOWPARSE_VLM_MAX_PIXELS=1003520
TEAMKNOWPARSE_RENDER_ZOOM=1.5
TEAMKNOWPARSE_VLM_RETRY_BACKOFF_SECONDS=0.75
TEAMKNOWPARSE_MAX_RETRIES=1
TEAMKNOWPARSE_ARTIFACT_ENCRYPTION_ENABLED=false
# Generate a local-only key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TEAMKNOWPARSE_ARTIFACT_ENCRYPTION_KEY=
TEAMKNOWPARSE_ARTIFACT_ENCRYPTION_KEY_FILE=
TEAMKNOWPARSE_CHROMA_COLLECTION=teamknowparse_kb_chunks
TEAMKNOWPARSE_CHROMA_DIR=./chroma_teamknowparse
# Production Fly volume path:
# TEAMKNOWPARSE_CHROMA_DIR=/data/chroma_teamknowparse
EMBEDDING_API_KEY=
# Some local OpenAI-compatible servers accept any non-empty key, for example local-vllm.
